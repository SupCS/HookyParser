# Railway injects DATABASE_URL through a reference to the PostgreSQL service.
DATABASE_URL=postgresql://user:password@host:5432/database

# Protects POST /api/collect. Generate a long random value for production.
COLLECTOR_KEY=change-me

# Showtime history horizon only (0-365, default 90).
# Release catalog discovery has no future-day limit.
# Set the same value in both web and cron services.
HOOKY_FUTURE_DAYS=90

# Enables release metadata and IMDb ranks; set in BOTH web and cron services.
OMDB_API_KEY=your-omdb-api-key

# Refresh a cached rank after this many hours (default 24).
IMDB_POPULARITY_CACHE_HOURS=24

# Retry failed OMDb/IMDb lookups sooner than successful ones.
IMDB_POPULARITY_ERROR_CACHE_MINUTES=15
